    "fieldType": "yesno",
    "answerFrom": "preferences",
    "prefKey": "sponsorshipNowOrFuture",
    "sensitivity": "consequential",
    "patterns": [
      "\\b(now|currently|present)\\b.{0,45}\\b(future|later|eventually)\\b.{0,160}\\b(sponsor\\w*|immigration case)\\b",
      "\\bsponsor\\w*\\b.{0,100}\\b(now|currently|present)\\b.{0,45}\\b(future|later|eventually)\\b"
    ],
