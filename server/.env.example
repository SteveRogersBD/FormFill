# Copy to server/.env. Real credentials and tokens never get committed.
# Path is resolved against the repository root when relative.
GOOGLE_APPLICATION_CREDENTIALS=sa_creds.json

APPLYAI_ENVIRONMENT=development

# 1 verifies X-Firebase-AppCheck on every request. Off locally so tests need no attestation.
APPLYAI_REQUIRE_APP_CHECK=0

# Explicit origins as a JSON list, for example ["chrome-extension://abcdefghijklmnopabcdefghijklmnop"].
# Leave unset in development to allow chrome-extension:// and loopback origins only.
# APPLYAI_ALLOWED_ORIGINS=[]

# Sessions idle longer than this are considered abandoned (cleanup lands with the graph).
APPLYAI_SESSION_TTL_HOURS=72
